# Keep the build context to what the Dockerfile actually COPYs
# (pyproject.toml, README.md, src/, automation/).
.git
.github
.claude
docs
charts
tests
site
mkdocs.yml
PROJECT_INDEX.json
CLAUDE.md

# Local env / secrets / scan output — must never enter an image
.env
.env.*
*.local.yaml
targets.local.yaml
secrets/
reports/
scan-output/
output/
*.sarif

# Python / tooling caches
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.uv/
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.DS_Store
